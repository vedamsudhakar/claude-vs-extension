<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ClaudeCodeVS</RootNamespace>
    <AssemblyName>ClaudeCodeVS</AssemblyName>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <VSSDKTargetPlatformRegRootSuffix>Exp</VSSDKTargetPlatformRegRootSuffix>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Workspace.VSIntegration" Version="17.12.19" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2094" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <!-- Terminal front-end (xterm.js, MIT) is bundled locally and served from the extension folder; no CDN. -->
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" IncludeInVSIX="true" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <VSCTCompile Include="ClaudeCodeVS.vsct" ResourceName="Menus.ctmenu" />
  </ItemGroup>
  <!-- SDK-style projects don't import the VSIX packaging targets on their own. Import them AFTER the common
       targets so TargetPath / IntermediateOutputPath are already defined. -->
  <PropertyGroup>
    <CustomAfterMicrosoftCommonTargets>$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets</CustomAfterMicrosoftCommonTargets>
  </PropertyGroup>
</Project>
